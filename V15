-- منطق حماية الإمساك والانتقام التلقائي (Anti-Grab Auto Reset & Revenge)
local AntiGrabEnabled = false

local function executeAutoReset(reason)
   if not AntiGrabEnabled then return end
   
   local char = lp.Character
   local hum = char and char:FindFirstChild("Humanoid")
   if hum and hum.Health > 0 then
       pcall(function()
           Rayfield:Notify({
               Title = "حماية الإمساك 🛡️",
               Content = "تم كشف الإمساك! جاري إعادة الترسيب التلقائي...",
               Duration = 2
           })
       end)
       
       local neck = char:FindFirstChild("Head") and char.Head:FindFirstChild("Neck")
       if neck then neck:Destroy() end
       hum.Health = 0
   end
end

local function setupAntiGrab(char)
   if not char then return end
   local hum = char:WaitForChild("Humanoid", 3)
   
   -- [ الإضافة الجديدة لحل المشكلة ]: منع اللاعب من السقوط على وجهه أو التعثر نهائياً
   if hum then
       pcall(function()
           hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
           hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
       end)
   end
   
   -- وظيفة مساعدة لتسجيل الهدف وتفعيل الرسباون
   local function triggerRespawn(attackerName, reason)
       if attackerName and Players:FindFirstChild(attackerName) then
           if ChosenTargetName1 == "" or ChosenTargetName1 == attackerName then
               ChosenTargetName1 = attackerName
               pcall(function() TargetDropdown1:Set({attackerName}) end)
           elseif ChosenTargetName2 == "" or ChosenTargetName2 == attackerName then
               ChosenTargetName2 = attackerName
               pcall(function() TargetDropdown2:Set({attackerName}) end)
           else
               ChosenTargetName3 = attackerName
               pcall(function() TargetDropdown3:Set({attackerName}) end)
           end
           SpecificTargetEnabled = true
           pcall(function()
               Rayfield:Notify({
                   Title = "نظام الانتقام 🎯",
                   Content = "تم تحديد [" .. attackerName .. "] كهدف!",
                   Duration = 3
               })
           end)
       end
       executeAutoReset(reason)
   end

   -- 1. فحص العناصر المضافة (مؤثرات الإمساك فقط)
   char.DescendantAdded:Connect(function(child)
       if not AntiGrabEnabled then return end
       task.wait(0.05) 
       
       if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
           return
       end
       
       local name = child.Name:lower()
       if name:find("grab") or name:find("stun") or name:find("hold") or name:find("carry") then
           if hum and (hum:GetState() == Enum.HumanoidStateType.PlatformStanding or hum.WalkSpeed < 5) then
               executeAutoReset("تأثير الإمساك: " .. child.Name)
           end
       end
   end)
   
   -- 2. الفحص الفيزيائي الدقيق (عندما يمسك بك الخصم وتفقد السيطرة)
   if hum then
       hum.StateChanged:Connect(function(_, newState)
           if not AntiGrabEnabled then return end
           
           if newState == Enum.HumanoidStateType.PlatformStanding or newState == Enum.HumanoidStateType.Physics then
               task.wait(0.05)
               
               local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
               if root then
                   for _, part in ipairs(root:GetConnectedParts()) do
                       local potentialEnemy = part.Parent
                       if potentialEnemy and potentialEnemy ~= char and potentialEnemy:FindFirstChildOfClass("Humanoid") then
                           triggerRespawn(potentialEnemy.Name, "تم الإمساك بك بواسطة: " .. potentialEnemy.Name)
                           return
                       end
                   end
               end
           end
       end)
   end
end



