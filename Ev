-- ═══ دوال مساعدة ═══
local function P(parent, name, size, cf, color, opts)
    opts = opts or {}
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = CF * cf
    p.Anchored = true
    p.CanCollide = opts.canCollide ~= false
    p.Material = opts.material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Transparency = opts.transparency or 0
    p.Reflectance = opts.reflectance or 0
    if opts.shape then p.Shape = opts.shape end
    p.Parent = parent
    return p
end

local function W_(parent, name, size, cf, color, opts)
    opts = opts or {}
    local p = Instance.new("WedgePart")
    p.Name = name
    p.Size = size
    p.CFrame = CF * cf
    p.Anchored = true
    p.CanCollide = opts.canCollide ~= false
    p.Material = opts.material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Reflectance = opts.reflectance or 0
    p.Parent = parent
    return p
end

-- ✅ دالة بناء جدار على محور X (يمتد عرضياً) مع فتحات
local function buildWallX(parent, name, xL, xR, yB, yT, zPos, openings, color, isInner)
    table.sort(openings, function(a, b) return a.pos[1] < b.pos[1] end)
    color = color or C.Wall
    local mat = Enum.Material.Concrete
    local cursor = xL
    for i, op in ipairs(openings) do
        local opL = op.pos[1] - op.size[1]/2
        local opR = op.pos[1] + op.size[1]/2
        local opB = op.pos[2] - op.size[2]/2
        local opT = op.pos[2] + op.size[2]/2
        if opL > cursor + 0.05 then
            P(parent, name.."_"..i.."a", Vector3.new(opL - cursor, yT - yB, T),
                CFrame.new((cursor + opL)/2, (yB + yT)/2, zPos), color, {material=mat})
        end
        if opB > yB + 0.05 then
            P(parent, name.."_"..i.."b", Vector3.new(op.size[1], opB - yB, T),
                CFrame.new(op.pos[1], (yB + opB)/2, zPos), color, {material=mat})
        end
        if opT < yT - 0.05 then
            P(parent, name.."_"..i.."c", Vector3.new(op.size[1], yT - opT, T),
                CFrame.new(op.pos[1], (opT + yT)/2, zPos), color, {material=mat})
        end
        cursor = opR
    end
    if cursor < xR - 0.05 then
        P(parent, name.."_end", Vector3.new(xR - cursor, yT - yB, T),
            CFrame.new((cursor + xR)/2, (yB + yT)/2, zPos), color, {material=mat})
    end
end

-- ✅ دالة بناء جدار على محور Z (يمتد عمقاً) مع فتحات
local function buildWallZ(parent, name, zL, zR, yB, yT, xPos, openings, color, isInner)
    table.sort(openings, function(a, b) return a.pos[1] < b.pos[1] end)
    color = color or C.Wall
    local mat = Enum.Material.Concrete
    local cursor = zL
    for i, op in ipairs(openings) do
        local opL = op.pos[1] - op.size[1]/2
        local opR = op.pos[1] + op.size[1]/2
        local opB = op.pos[2] - op.size[2]/2
        local opT = op.pos[2] + op.size[2]/2
        if opL > cursor + 0.05 then
            P(parent, name.."_"..i.."a", Vector3.new(T, yT - yB, opL - cursor),
                CFrame.new(xPos, (yB + yT)/2, (cursor + opL)/2), color, {material=mat})
        end
        if opB > yB + 0.05 then
            P(parent, name.."_"..i.."b", Vector3.new(T, opB - yB, op.size[1]),
                CFrame.new(xPos, (yB + opB)/2, op.pos[1]), color, {material=mat})
        end
        if opT < yT - 0.05 then
            P(parent, name.."_"..i.."c", Vector3.new(T, yT - opT, op.size[1]),
                CFrame.new(xPos, (opT + yT)/2, op.pos[1]), color, {material=mat})
        end
        cursor = opR
    end
    if cursor < zR - 0.05 then
        P(parent, name.."_end", Vector3.new(T, yT - yB, zR - cursor),
            CFrame.new(xPos, (yB + yT)/2, (cursor + zR)/2), color, {material=mat})
    end
end

