local carCF = CF * CFrame.new(W/2 + 12, 0, D/2 + 8) * CFrame.Angles(0, math.rad(-90), 0)

local function carPart(name, size, offsetCF, color, opts)
    opts = opts or {}
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = carCF * offsetCF
    p.Anchored = true
    p.CanCollide = opts.canCollide ~= false
    p.Material = opts.material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Transparency = opts.transparency or 0
    p.Reflectance = opts.reflectance or 0
    if opts.shape then p.Shape = opts.shape end
    p.Parent = ferrari
    return p
end

local function carWedge(name, size, offsetCF, color, opts)
    opts = opts or {}
    local p = Instance.new("WedgePart")
    p.Name = name
    p.Size = size
    p.CFrame = carCF * offsetCF
    p.Anchored = true
    p.CanCollide = opts.canCollide ~= false
    p.Material = opts.material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Reflectance = opts.reflectance or 0
    p.Parent = ferrari
    return p
end

