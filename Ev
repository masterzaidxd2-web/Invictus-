        Vector3.new(0.5, 0.8, 0.5), 
        CFrame.new(x, 0.6 + fenceH + 0.4, z), 
        C.Trim, {material=Enum.Material.Wood})
end

local function createFenceRail(name, x1, z1, x2, z2)
    local dx = x2 - x1
    local dz = z2 - z1
    local length = math.sqrt(dx^2 + dz^2)
    local angle = math.deg(math.atan2(dz, dx))
    local cx = (x1 + x2) / 2
    local cz = (z1 + z2) / 2
    
    -- العارضات الأفقية (2 طبقات)
    for i = 1, 2 do
        local y = 0.6 + (i * 0.9)
        createPart(gardenParts, name.."_Rail"..i, 
            Vector3.new(length, 0.25, 0.25), 
            CFrame.new(cx, y, cz) * CFrame.Angles(0, math.rad(-angle), 0), 
            C.Trim, {material=Enum.Material.Wood})
    end
end

