        CFrame.new(x, y, z), Color3.fromRGB(255, 250, 230), {material=Enum.Material.Neon, canCollide=false})
    -- الإضاءة
    local light = Instance.new("PointLight")
    light.Brightness = brightness
    light.Range = range
    light.Color = C.Light
    light.Shadows = true
    light.Parent = bulb
end

