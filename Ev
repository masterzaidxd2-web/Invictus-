-- ═══ دالة الأساس ═══
local function Part(name, size, cf, color, material, parent)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = BASE_CF * cf   -- ← تطبيق الموقع المخصص
    p.Anchored = true
    p.CanCollide = true
    p.Color = color or WHITE
    p.Material = material or MAT_WALL
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent or House
    return p
end

local function Glass(name, size, cf)
    local p = Part(name, size, cf, GLASS, MAT_GLASS)
    p.Transparency = 0.35
    p.Reflectance = 0.15
    return p
end

local function Cylinder(name, radius, height, cf, color, material)
    local p = Part(name, Vector3.new(radius*2, height, radius*2), cf, color, material)
    p.Shape = Enum.PartType.Cylinder
    return p
end

local function Ball(name, size, cf, color, material)
    local p = Part(name, size, cf, color, material)
    p.Shape = Enum.PartType.Ball
    return p
end

-- ═══ الإضاءة ═══
local function AddLight(parent, color, brightness, range)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Shadows = true
    light.Parent = parent
    return light
end

local function CeilingLight(pos)
    local lamp = Part("CeilingLight", Vector3.new(1.5, 0.15, 1.5),
        CFrame.new(pos), WHITE, Enum.Material.Neon)
    AddLight(lamp, Color3.fromRGB(255, 235, 190), 2.5, 18)
end

