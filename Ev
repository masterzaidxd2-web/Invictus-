-- يقع على الجدار الأيمن، يصعد من Z=+2 (أمام) إلى Z=-12 (خلف)
local stepCount = 15
local stepH = (Y2_BOT - Y1_BOT) / stepCount
local stepD = 1.4
local stepW = 6
local stairX = W/2 - stepW/2 - 1  -- 21.5 (على يمين المنزل)
local stairStartZ = 2  -- يبدأ من الأمام (Z=2) ويصعد للخلف

