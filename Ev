    createPart(garden, name.."_P", Vector3.new(0.5, fenceH, 0.5), CFrame.new(x, 0.6 + fenceH/2, z), C.Trim, {material=Enum.Material.Wood})
    createWedge(garden, name.."_T", Vector3.new(0.6, 0.9, 0.6), CFrame.new(x, 0.6 + fenceH + 0.45, z), C.Trim, {material=Enum.Material.Wood})
end

local function fenceRail(name, x1, z1, x2, z2)
    local dx, dz = x2 - x1, z2 - z1
    local len = math.sqrt(dx*dx + dz*dz)
    local angle = math.deg(math.atan2(dz, dx))
    local cx, cz = (x1+x2)/2, (z1+z2)/2
    for i = 1, 2 do
        local y = 0.6 + i * 1.1
        createPart(garden, name.."_R"..i, Vector3.new(len, 0.3, 0.3),
            CFrame.new(cx, y, cz) * CFrame.Angles(0, math.rad(-angle), 0), C.Trim, {material=Enum.Material.Wood})
    end
end

