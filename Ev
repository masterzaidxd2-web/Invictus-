    local stepY = Y1_BOT + i * stepH
    local stepZ = stairStartZ - (i - 0.5) * stepD
    
    -- الدرجة
    createPart(house, "Stair_"..i, Vector3.new(stepW, 0.4, stepD), 
        CFrame.new(stairX, stepY, stepZ), C.Floor, {material=Enum.Material.WoodPlanks})
    
    -- عمود الدرابزين (يسار - جهة الداخل)
    createPart(house, "StairRail_L_"..i, Vector3.new(0.3, 2, 0.3),
        CFrame.new(stairX - stepW/2, stepY + 1, stepZ), C.Trim, {material=Enum.Material.Wood})
    
    -- عمود الدرابزين (يمين - على الجدار)
    createPart(house, "StairRail_R_"..i, Vector3.new(0.3, 2, 0.3),
        CFrame.new(stairX + stepW/2, stepY + 1, stepZ), C.Trim, {material=Enum.Material.Wood})
end

-- الدرابزين العلوي المائل (Rail)
local railLen = math.sqrt((stepCount * stepD)^2 + (stepCount * stepH)^2)
local railAngle = math.deg(math.atan2(stepCount * stepH, stepCount * stepD))
local railMidZ = stairStartZ - (stepCount * stepD) / 2
local railMidY = Y1_BOT + (stepCount * stepH) / 2 + 1

createPart(house, "StairRailTop_L", Vector3.new(0.35, 0.35, railLen),
    CFrame.new(stairX - stepW/2, railMidY, railMidZ) * CFrame.Angles(math.rad(railAngle), 0, 0),
    C.Trim, {material=Enum.Material.Wood})

createPart(house, "StairRailTop_R", Vector3.new(0.35, 0.35, railLen),
    CFrame.new(stairX + stepW/2, railMidY, railMidZ) * CFrame.Angles(math.rad(railAngle), 0, 0),
    C.Trim, {material=Enum.Material.Wood})

-- هيكل تحتي للدرج
createPart(house, "Stair_Support", Vector3.new(stepW, 0.5, stepCount * stepD),
    CFrame.new(stairX, Y1_BOT + stepCount * stepH / 2, stairStartZ - stepCount * stepD / 2) * CFrame.Angles(math.rad(railAngle), 0, 0),
    C.Wood, {material=Enum.Material.Wood})
