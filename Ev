    local vis = House:GetAttribute("Visible")
    if vis == nil then vis = true end
    vis = not vis
    House:SetAttribute("Visible", vis)
    for _, obj in ipairs(House:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Transparency = vis and 0 or 1
            obj.CanCollide = vis
        elseif obj:IsA("PointLight") then
            obj.Enabled = vis
        end
    end
end)

