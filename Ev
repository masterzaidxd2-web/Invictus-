-- 🔧 دوال مساعدة
-- ═══════════════════════════════════════════════
local function createPart(parent, name, size, offsetCF, color, opts)
    opts = opts or {}
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = CF * offsetCF
    part.Anchored = true
    part.CanCollide = opts.canCollide ~= false
    part.Material = opts.material or Enum.Material.SmoothPlastic
    part.Color = color
    part.Transparency = opts.transparency or 0
    part.Reflectance = opts.reflectance or 0
    if opts.shape then part.Shape = opts.shape end
    part.Parent = parent
    return part
end

local function createWedge(parent, name, size, offsetCF, color, opts)
    opts = opts or {}
    local part = Instance.new("WedgePart")
    part.Name = name
    part.Size = size
    part.CFrame = CF * offsetCF
    part.Anchored = true
    part.CanCollide = opts.canCollide ~= false
    part.Material = opts.material or Enum.Material.SmoothPlastic
    part.Color = color
    part.Reflectance = opts.reflectance or 0
    part.Parent = parent
    return part
end

-- ✅ دالة إنشاء نافذة كاملة
local function createWindow(parent, name, offsetCF, width, height, rotY)
    rotY = rotY or 0
    local wcf = offsetCF * CFrame.Angles(0, math.rad(rotY), 0)
    
    -- الزجاج
    createPart(parent, name.."_Glass", Vector3.new(width, height, 0.15), wcf, C.Glass, 
        {transparency=0.65, material=Enum.Material.Glass, reflectance=0.4, canCollide=false})
    
    -- الإطارات الأربعة (خشبية)
    local t = 0.35
    createPart(parent, name.."_FT", Vector3.new(width + t*2, t, 0.4), wcf * CFrame.new(0, height/2, 0), C.Trim, {material=Enum.Material.Wood})
    createPart(parent, name.."_FB", Vector3.new(width + t*2, t, 0.4), wcf * CFrame.new(0, -height/2, 0), C.Trim, {material=Enum.Material.Wood})
    createPart(parent, name.."_FL", Vector3.new(t, height, 0.4), wcf * CFrame.new(-width/2, 0, 0), C.Trim, {material=Enum.Material.Wood})
    createPart(parent, name.."_FR", Vector3.new(t, height, 0.4), wcf * CFrame.new(width/2, 0, 0), C.Trim, {material=Enum.Material.Wood})
    
    -- تقسيم داخلي (صليب)
    createPart(parent, name.."_CrossV", Vector3.new(t*0.7, height, 0.2), wcf, C.Trim, {material=Enum.Material.Wood})
    createPart(parent, name.."_CrossH", Vector3.new(width, t*0.7, 0.2), wcf, C.Trim, {material=Enum.Material.Wood})
end

-- ✅ دالة إنشاء مصباح سقف
local function createCeilingLamp(parent, name, offsetCF, range, brightness)
    range = range or 25
    brightness = brightness or 2.5
    
    -- القاعدة
    createPart(parent, name.."_Base", Vector3.new(1.5, 0.3, 1.5), offsetCF * CFrame.new(0, 0.3, 0), C.Metal, {material=Enum.Material.Metal})
    
    -- الجزء المضيء
    local bulb = createPart(parent, name.."_Bulb", Vector3.new(1.2, 0.4, 1.2), offsetCF, 
        Color3.fromRGB(255, 250, 230), {material=Enum.Material.Neon, canCollide=false})
    
    -- PointLight
    local light = Instance.new("PointLight")
    light.Brightness = brightness
    light.Range = range
    light.Color = C.Light
    light.Shadows = true
    light.Parent = bulb
end

