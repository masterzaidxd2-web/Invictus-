local function createPart(name, size, offsetCF, color, opts)
    opts = opts or {}
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = HOUSE_CF * offsetCF
    part.Anchored = true
    part.CanCollide = opts.canCollide ~= false
    part.Material = opts.material or Enum.Material.SmoothPlastic
    part.Color = color
    part.Transparency = opts.transparency or 0
    part.Reflectance = opts.reflectance or 0
    if opts.shape then part.Shape = opts.shape end
    part.Parent = houseFolder
    return part
end

