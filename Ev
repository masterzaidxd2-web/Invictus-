-- 🏎️ Ferrari 488 GTB - تفصيلية بـ WedgeParts
-- ═══════════════════════════════════════════════
local carCF = CF * CFrame.new(18, 0, D/2 + 18) * CFrame.Angles(0, math.rad(90), 0)

local function createCarPart(name, size, offsetCF, color, opts)
    opts = opts or {}
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = carCF * offsetCF
    part.Anchored = true
    part.CanCollide = opts.canCollide ~= false
    part.Material = opts.material or Enum.Material.SmoothPlastic
    part.Color = color
    part.Transparency = opts.transparency or 0
    part.Reflectance = opts.reflectance or 0
    if opts.shape then part.Shape = opts.shape end
    part.Parent = carFolder
    return part
end

local function createCarWedge(name, size, offsetCF, color, opts)
    opts = opts or {}
    local part = Instance.new("WedgePart")
    part.Name = name
    part.Size = size
    part.CFrame = carCF * offsetCF
    part.Anchored = true
    part.CanCollide = opts.canCollide ~= false
    part.Material = opts.material or Enum.Material.SmoothPlastic
    part.Color = color
    part.Reflectance = opts.reflectance or 0
    part.Parent = carFolder
    return part
end

