local function ceilingLamp(name, x, y, z, brightness, range)
    brightness = brightness or 2.5
    range = range or 25
    createPart(house, name.."_Base", Vector3.new(1.5, 0.3, 1.5), CFrame.new(x, y + 0.15, z), C.Metal, {material=Enum.Material.Metal})
