local carCF = CF * CFrame.new(W/2 + 14, 0, D/2 + 12) * CFrame.Angles(0, math.rad(-90), 0)

local function carP(name, size, cf, color, opts)
    opts = opts or {}
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = carCF * cf
    p.Anchored = true
    p.CanCollide = opts.canCollide ~= false
    p.Material = opts.material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Transparency = opts.transparency or 0
    p.Reflectance = opts.reflectance or 0
    if opts.shape then p.Shape = opts.shape end
    p.Parent = ferrari
    return p
end

local function carW(name, size, cf, color, opts)
    opts = opts or {}
    local p = Instance.new("WedgePart")
    p.Name = name
    p.Size = size
    p.CFrame = carCF * cf
    p.Anchored = true
    p.CanCollide = opts.canCollide ~= false
    p.Material = opts.material or Enum.Material.SmoothPlastic
    p.Color = color
    p.Reflectance = opts.reflectance or 0
    p.Parent = ferrari
    return p
end

