        CFrame.new(x, y, z), C.Neon,
        {material=Enum.Material.Neon, canCollide=false})
    local light = Instance.new("PointLight")
    light.Brightness = brightness
    light.Range = range
    light.Color = C.Light
    light.Shadows = true
    light.Parent = bulb
end

