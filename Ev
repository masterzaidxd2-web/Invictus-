local function createFencePost(name, x, z)
    -- العمود
    createPart(gardenParts, name.."_Post", 
        Vector3.new(0.4, fenceH, 0.4), 
        CFrame.new(x, 0.6 + fenceH/2, z), 
        C.Trim, {material=Enum.Material.Wood})
    
    -- القمة المدببة
