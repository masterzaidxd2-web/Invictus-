local conn = nil

local function isSafe(name)
    local lowerName = name:lower()
    local boxes = {SAVE.safe1, SAVE.safe2, SAVE.safe3}
    for _, boxText in ipairs(boxes) do
        for s in boxText:gmatch("%S+") do
            if lowerName:find(s:lower(), 1, true) then return true end
        end
    end
    return false
end

local function isTarget(name)
    if AuraTargetSelected == "All" or AuraTargetSelected == "" then return true end
    return name:lower() == AuraTargetSelected:lower()
end

local function doHit(hum, pos)
    if not hum or not hum.Parent then return end
    if HitR then
        if HitR:IsA("RemoteEvent") then
            HitR:FireServer(hum, Vector3.new(pos.X, pos.Y, pos.Z))
        elseif HitR:IsA("RemoteFunction") then
            HitR:InvokeServer(hum, Vector3.new(pos.X, pos.Y, pos.Z))
        end
    end
end

