-- محرك القفز اللانهائي
UserInputService.JumpRequest:Connect(function()
    if isInfJump and lp.Character then
        local humanoid = lp.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local shouldGrab = AutoGrab

    if AutoTargetEnabled then
        local myChar = lp.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local myPos = myChar.HumanoidRootPart.Position
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= lp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    if (myPos - player.Character.HumanoidRootPart.Position).Magnitude <= TriggerDistance then
                        shouldGrab = true
                        break
                    end
                end
            end
        end
    end

    if SpecificTargetEnabled and ChosenTargetPlayer and ChosenTargetPlayer.Parent then
        local myChar = lp.Character
        local targetChar = ChosenTargetPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local distance = (myChar.HumanoidRootPart.Position - targetChar.HumanoidRootPart.Position).Magnitude
            if distance <= TriggerDistance then
                shouldGrab = true
            end
        end
    else
        if ChosenTargetPlayer and not ChosenTargetPlayer.Parent then
            SpecificTargetEnabled = false
            ChosenTargetPlayer = nil
        end
    end

    if shouldGrab and GrabRF then
        for i = 1, 5 do
            task.spawn(function()
                pcall(function()
                    GrabRF:InvokeServer()
                end)
            end)
        end
    end
end)

RunService.Heartbeat:Connect(function(dt)
    if not rainbowNameRemote or not BWNameActive then return end
    local now = os.clock()

    rnHue = (rnHue + (dt * rnSpeed)) % 1
    
    if now - bwLastUpdate >= (currentNameMode == "Police" and 0.12 or rnUpdateRate) then
        local targetColor
        
        if currentNameMode == "BW" then
            local intensity = (math.sin(rnHue * math.pi * 2) + 1) / 2
            targetColor = Color3.new(intensity, intensity, intensity)
            
        elseif currentNameMode == "Rainbow" then
            targetColor = Color3.fromHSV(rnHue, 1, 1)
            
        elseif currentNameMode == "Pulse" then
            targetColor = Color3.fromHSV(rnHue, 0.8, 1)
            
        elseif currentNameMode == "Strobe" then
            targetColor = Color3.fromRGB(math.random(50, 255), math.random(50, 255), math.random(50, 255))
            
        elseif currentNameMode == "Police" then
            policeToggle = not policeToggle
            if policeToggle then
                targetColor = Color3.f
