                        if gui:IsA("ScreenGui") then
                            gui.Enabled = state -- تفعيل أو تعطيل الرؤية
                        end
                    end
                end
            end
            
            searchAndToggle(coreGui)
            searchAndToggle(playerGui)
        end

        if Value then
            -- عند تشغيل الزر (On)
            if not EmoteLoaded then
                -- إذا كانت هذه هي المرة الأولى، نقوم بتشغيل الرابط
                pcall(function()
