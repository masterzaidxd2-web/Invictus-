local function resetCameraSubject()
    if workspace.CurrentCamera and lp.Character then
        local humanoid = lp.Character:FindFirstChildWhichIsA("Humanoid")
        if humanoid then
            workspace.CurrentCamera.CameraSubject = humanoid
        end
    end
end

local function createTween(hrp, targetCFrame)
    local tweenInfo = TweenInfo.new(TeleportTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    return TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
end

local function startVelLoop(hrp)
    if velConn then velConn:Disconnect() end
    velConn = RunService.Heartbeat:Connect(function()
        if flingToggle and hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function stopVelLoop()
    if velConn then
        velConn:Disconnect()
        velConn = nil
    end
end

local function toggleFling()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if flingToggle then
        -- 🔴 إيقاف الفلينق وإعادة تشغيل الحماية من السقوط
        flingToggle = false
        getgenv().IsFlinging = false 
        
        FlingBtn.Text = "🚀 Fling: OFF"
        FlingBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
        stopVelLoop()
        
        if lastPos then
            local tweenBack = createTween(hrp, CFrame.new(lastPos))
            tweenBack:Play()
            tweenBack.Completed:Wait()
        end
        
        workspace.FallenPartsDestroyHeight = -500
        resetCameraSubject()
        if workspace:FindFirstChild("Gaze") then
            workspace.Gaze:Destroy()
        end
    else
        -- 🟢 تشغيل الفلينق وإيقاف الحماية من السقوط مؤقتاً
        flingToggle = true
        getgenv().IsFlinging = true 
        
        lastPos = hrp.Position
        local part = Instance.new("Part")
        part.Size = Vector3.new(4, 1, 4)
        part.Position = lastPos
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 0.5
        part.Name = "Gaze"
        part.Parent = workspace
        
        if workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = part
        end
        
        FlingBtn.Text = "🚀 Fling: ON"
        FlingBtn.BackgroundColor3 = Color3.fromRGB(60, 220, 60)
        
        task.wait()
        workspace.FallenPartsDestroyHeight = -1000
        local tweenToTarget = createTween(hrp, CFrame.new(targetPos))
        tweenToTarget:Play()
        tweenToTarget.Completed:Wait()
        startVelLoop(hrp)
    end
end

