local function getEspColor(playerName)
  if isSafe(playerName) then return Color3.fromRGB(0, 255, 100) end
  local isAuraTarget = (AuraTargetSelected ~= "All" and AuraTargetSelected ~= "" and playerName == AuraTargetSelected)
  local isGrabTarget = (SpecificTargetEnabled and (playerName == ChosenTargetName1 or playerName == ChosenTargetName2 or playerName == ChosenTargetName3))
  if isAuraTarget or isGrabTarget then return Color3.fromRGB(255, 50, 50) end
  return Color3.fromRGB(255, 255, 255)
end

local function removeEsp(player)
    if not player then return end
    local hl = EspFolder:FindFirstChild(player.Name .. "_HL")
    local bb = EspFolder:FindFirstChild(player.Name .. "_BB")
    if hl then hl:Destroy() end
    if bb then bb:Destroy() end
end

local function applyEsp(player)
   if player == lp then return end
   
   local hl = EspFolder:FindFirstChild(player.Name .. "_HL")
   local bb = EspFolder:FindFirstChild(player.Name .. "_BB")

   if not EspEnabled or not player.Character then
       if hl then hl.Enabled = false end
       if bb then bb.Enabled = false end
       return
   end

   local char = player.Character
   local root = char:FindFirstChild("HumanoidRootPart")
   local head = char:FindFirstChild("Head") or root
   local targetColor = getEspColor(player.Name)

   -- إعداد الصندوق (Highlight)
   if EspBoxes and char then
       if not hl then
           hl = Instance.new("Highlight")
           hl.Name = player.Name .. "_HL"
           hl.Parent = EspFolder
       end
       hl.Adornee = char
       hl.FillColor = targetColor
       hl.OutlineColor = Color3.fromRGB(255, 255, 255)
       hl.FillTransparency = 0.5
       hl.OutlineTransparency = 0
       hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
       hl.Enabled = true
   elseif hl then
       hl.Enabled = false
   end

   -- إعداد الاسم (BillboardGui)
   if EspNames and head then
       if not bb then
           bb = Instance.new("BillboardGui")
           bb.Name = player.Name .. "_BB"
           bb.Size = UDim2.new(0, 200, 0, 45)
           bb.StudsOffset = Vector3.new(0, 3, 0)
           bb.AlwaysOnTop = true
           
           local textLabel = Instance.new("TextLabel")
           textLabel.Name = "Text"
           textLabel.Size = UDim2.new(1, 0, 1, 0)
           textLabel.BackgroundTransparency = 1
           textLabel.TextStrokeTransparency = 0.4
           textLabel.Font = Enum.Font.SourceSansBold
           textLabel.TextSize = 13
           textLabel.Parent = bb
           bb.Parent = EspFolder
       end
       
       bb.Adornee = head
       bb.Enabled = true
       
       local myChar = lp.Character
       local dist = 0
       if myChar and myChar:FindFirstChild("HumanoidRootPart") and root then
           dist = math.floor((myChar.HumanoidRootPart.Position - root.Position).Magnitude)
       end
       
       -- عرض الاسم الأصلي فقط بناءً على طلبك
       bb.Text.TextColor3 = targetColor
       bb.Text.Text = "@" .. player.Name .. "\n[" .. tostring(dist) .. " Studs]"
   elseif bb then
       bb.Enabled = false
   end
end

