local NoclipConnection = nil

local function noclip()
    if NoclipConnection then NoclipConnection:Disconnect() end
    
    NoclipConnection = RunService.Stepped:Connect(function()
        if lp.Character then
            for _, v in ipairs(lp.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)
end

local function clip()
    -- إلغاء حلقة التكرار أولاً
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end
    
    -- إرجاع التصادم للجذع والرأس فقط (الأجزاء الأساسية للتصادم)
    if lp.Character then
        for _, v in ipairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                if v.Name == "Head" or v.Name == "Torso" or v.Name == "UpperTorso" or v.Name == "LowerTorso" then
                    v.CanCollide = true
                else
                    v.CanCollide = false
                end
            end
        end
    end
end
local PlayerCollisionEnabled = false
local PlayerCollisionConn = nil
local LocalStands = {}

local function cleanupStands()
    for _, stand in pairs(LocalStands) do
        if stand and stand.Parent then
            stand:Destroy()
        end
    end
    LocalStands = {}
end

local function enablePlayerCollisions()
    if PlayerCollisionConn then PlayerCollisionConn:Disconnect() end
    
    PlayerCollisionConn = RunService.Stepped:Connect(function()
        if not PlayerCollisionEnabled then return end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character then
                local head = player.Character:FindFirstChild("Head")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                
                if head and hum and hum.Health > 0 then
                    local stand = LocalStands[player.Name]
                    if not stand or not stand.Parent then
                        stand = Instance.new("Part")
                        stand.Name = "LocalHeadStand"
                        stand.Size = Vector3.new(2.5, 0.4, 2.5)
                        stand.Transparency = 1 -- خفي تماماً
                        stand.Anchored = true
                        stand.CanCollide = true
                        stand.Parent = workspace
                        LocalStands[player.Name] = stand
                    end
                    -- تثبيت المنصة الخفية فوق رأس اللاعب مباشرة
                    stand.CFrame = head.CFrame * CFrame.new(0, 0.7, 0)
                else
                    if LocalStands[player.Name] then
                        LocalStands[player.Name]:Destroy()
                        LocalStands[player.Name] = nil
                    end
                end
            end
        end
    end)
end

local function disablePlayerCollisions()
    if PlayerCollisionConn then
        PlayerCollisionConn:Disconnect()
        PlayerCollisionConn = nil
    end
    cleanupStands()
end

